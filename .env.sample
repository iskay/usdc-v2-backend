# Application Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# CORS Configuration
# Comma-separated list of allowed origins (e.g., "http://localhost:5173,http://localhost:3000")
CORS_ORIGINS=

# Database Configuration
# PostgreSQL connection string
# For Docker Compose: postgresql://postgres:postgres@postgres:5432/usdc_v2_backend
# For local: postgresql://user:password@localhost:5432/usdc_v2_backend
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/usdc_v2_backend

# Redis Configuration
# Redis connection string
# For Docker Compose: redis://redis:6379
# For local: redis://localhost:6379
REDIS_URL=redis://redis:6379

# RPC Configuration
# Comma-separated list of EVM RPC endpoints
# Example: https://sepolia.infura.io/v3/YOUR_KEY,https://sepolia.etherscan.io
EVM_RPC_URLS=

# Comma-separated list of Tendermint RPC endpoints
# Example: https://rpc.testnet.namada.net,https://rpc.testnet.noble.net
TENDERMINT_RPC_URLS=

# Chain Registry Configuration
# Path to custom chain registry JSON file (optional)
CHAIN_REGISTRY_PATH=

# JSON string of chain polling configurations (optional)
CHAIN_POLLING_CONFIGS=

# Noble Forwarding Configuration
# Noble LCD base URL (required for Noble forwarding registration)
# Example: https://lcd.testnet.noble.net
NOBLE_LCD_BASE=

# Noble IBC channel ID (default: channel-136 for Noble → Namada)
NOBLE_CHANNEL_ID=channel-136

# Noble fallback address (optional, default: empty string)
NOBLE_FALLBACK=

# Minimum uusdc balance required for registration (default: 20000 = 0.02 USDC)
NOBLE_REG_MIN_UUSDC=20000

# Gas limit for registration transaction (default: 125000)
NOBLE_REG_GAS=125000

# Registration fee in uusdc (default: 12500 = 0.0125 USDC)
NOBLE_REG_FEE_UUSDC=12500

# Check interval in milliseconds (default: 60000 = 1 minute)
NOBLE_REG_CHECK_INTERVAL_MS=60000

# Stale threshold in milliseconds (default: 86400000 = 24 hours)
# Registrations older than this will be marked as stale
NOBLE_REG_STALE_MS=86400000
